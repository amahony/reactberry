{
  "name": "@reactberry/forms",
  "version": "1.1.13",
  "description": "Approved initial public Reactberry package surface for form components.",
  "main": "./index.js",
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "require": "./index.js",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.js"
  ],
  "repository": "https://github.com/amahony/reactberry.git",
  "scripts": {
    "start": "webpack-dev-server",
    "build": "npm run clean && npm run build:cjs && npm run build:esm",
    "build:cjs": "babel src --out-dir dist/cjs --config-file ./babel.config.cjs.json",
    "build:esm": "babel src --out-dir dist/esm --config-file ./babel.config.esm.json",
    "clean": "rm -rf dist",
    "dist": "npm run build",
    "prepack": "npm run build",
    "test": "echo @reactberry/forms"
  },
  "dependencies": {
    "@reactberry/core": "^1.1.8",
    "react-form": "^4.0.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.4.4",
    "@babel/core": "^7.4.5",
    "@babel/preset-env": "^7.4.5",
    "@babel/preset-react": "^7.0.0",
    "babel-loader": "^8.0.6",
    "prop-types": "^15.7.2",
    "react": "^16.8.6",
    "react-dom": "^16.8.6",
    "styled-components": "^5.1.1",
    "styled-system": "^5.1.5",
    "webpack": "^4.32.2",
    "webpack-cli": "^3.3.2",
    "webpack-dev-server": "^3.4.1"
  },
  "peerDependencies": {
    "react": ">= 16",
    "react-dom": ">= 16",
    "styled-components": "^5.1.1",
    "styled-system": "^5.1.5"
  },
  "license": "MIT",
  "author": "Atanas Mahony <atanas@codeberry.io>",
  "gitHead": "d4c4f46bfc825b2ca001fa4ddcd088173831fa1d"
}
